{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kokoro TTS Studio",
  "version": "0.1.0",
  "identifier": "com.kokoro.tts.studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kokoro TTS Studio",
        "url": "index.html",
        "width": 1140,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
